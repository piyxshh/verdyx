{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/index.py"
    },
    {
      "source": "/predict/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/health/:path*",
      "destination": "/api/index.py"
    }
  ]
}
